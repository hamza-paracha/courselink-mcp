[Unit]
Description=CourseLink monitor and MCP server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/courselink-mcp
Environment="COURSELINK_STATE_DIR=%h/.local/share/courselink-mcp"
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/courselink-mcp/.venv/bin/courselink serve
Restart=always
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=1500M
CPUQuota=75%

[Install]
WantedBy=default.target
